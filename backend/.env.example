# Postgres connection string — Railway's Postgres plugin injects DATABASE_URL automatically.
DATABASE_URL=postgres://user:pass@host:5432/railway

# Random 64+ char string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# EXACTLY 32 bytes, base64-encoded. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# This encrypts every exchange API secret / wallet private key at rest. Losing this key makes
# every stored credential permanently undecryptable — back it up somewhere other than this file.
MASTER_KEY=

# Comma-separated list of origins allowed to call this API (your GitHub Pages site + local dev).
ALLOWED_ORIGINS=https://erebusliquidityelpp.github.io,http://localhost:3000

# Optional — only needed if you want the FRED macro-data proxy route to work (free signup key).
FRED_API_KEY=

PORT=8080
